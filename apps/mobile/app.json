{
  "expo": {
    "name": "pethouse",
    "slug": "pethouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "pethouse",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.kataiga.pethouse"
    },
    "android": {
      "package": "fr.kataiga.pethouse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1A1C"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1A1C",
          "image": "./assets/splash-icon.png"
        }
      ],
      "react-native-edge-to-edge",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "backgroundColor": "#0B1A1C"
  }
}
