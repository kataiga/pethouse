# Copy to `.env` for local development. Values below match `docker compose up` from this directory.
# Every variable is validated at boot (src/config/environment.ts); a missing required one stops the API.

# --- Application ---------------------------------------------------------------------------------
# development | test | production (default: development)
NODE_ENV=development
PORT=3000
# pino level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=debug
# Comma-separated origins allowed by CORS. Empty allows none. Expo web dev server by default.
CORS_ORIGINS=http://localhost:8081

# --- Database (required) --------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pethouse
DB_NAME=pethouse

# --- Redis, used by the BullMQ scheduler (required) -----------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# Key prefix of the queues (default `pethouse`).
# REDIS_PREFIX=pethouse
# Run the scheduler workers in this process (default true). Every replica may run them: jobs are
# taken by one worker each and occurrences are claimed in the database, so nothing is sent twice.
# SCHEDULER_ENABLED=true

# --- JWT (secrets required, at least 32 characters; generate with `openssl rand -hex 32`) ----------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
JWT_REFRESH_TTL=30d

# --- S3-compatible photo storage, MinIO locally (required) ----------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
# Base URL phones read photos from. Same as the endpoint locally; the public ingress in production.
# S3_PUBLIC_URL=https://photos.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=pethouse
S3_SECRET_KEY=pethouse-dev-secret
S3_BUCKET=pethouse-photos
# MinIO needs path-style URLs (default: true)
S3_FORCE_PATH_STYLE=true

# --- Expo push (optional) -------------------------------------------------------------------------
# EXPO_ACCESS_TOKEN=
