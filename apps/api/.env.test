# Loaded automatically under NODE_ENV=test (Jest sets it) and by the OpenAPI dump.
# Committed on purpose: these are placeholders for local tests and CI, not secrets. Real environment
# variables take precedence, which is how the CI jobs point at their own MySQL and Redis services.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pethouse
DB_NAME=pethouse_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_ACCESS_SECRET=test-only-access-secret-not-a-real-secret-0000
JWT_REFRESH_SECRET=test-only-refresh-secret-not-a-real-secret-000

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=pethouse
S3_SECRET_KEY=pethouse-test-secret
S3_BUCKET=pethouse-photos-test

CORS_ORIGINS=http://localhost:8081
